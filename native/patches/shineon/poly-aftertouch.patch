+/* polyphonic aftertouch per key of each sound, as 127 - level (0 = as played): the voices a held (or latched) key
+ * starts later take it too, its arp's steps in every octave included; a new press of the key starts at full, and a
+ * voice of a pitch no key holds (the sequencer's steps, a key let go) plays as played (FMutate) */
+static uint8_t note_quiet[NPART][128];
+static int32_t trig_key = -1;                   /* the held key an arp step plays (its octaves are other pitches) */
+
+/* the level a voice of `note` takes: its key's while held or latched (an arp step: the key it plays), else full */
+static uint8_t key_level(uint32_t p, uint32_t note)
+{
+    uint32_t i, k = trig_key >= 0 ? (uint32_t)trig_key : note;
+    p %= NPART;
+    for (i = 0; i < nheld[p]; i++)
+        if (held[p][i].note == k) return (uint8_t)(127u - note_quiet[p][k & 127u]);
+    return 127u;
+}
