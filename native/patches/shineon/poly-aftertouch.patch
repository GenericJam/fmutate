+/* polyphonic aftertouch: the key's level, for every voice of that key of that sound, held or dying away, and the
+ * ones it starts later (FMutate) */
+static void ev_pressure(uint32_t p, uint32_t note, uint32_t val)
+{
+    uint32_t v;
+    if (val > 127u) val = 127u;
+    note_quiet[p][note & 127u] = (uint8_t)(127u - val);
+    for (v = 0; v < NV; v++)
+        if (vc[v].note == note && vc[v].part == p) vc[v].at = (uint8_t)val;
+}
+
 static void parts_off(uint32_t p)               /* a sound gone (B back on A, a panic): its keys, its arp, its notes */
 {
+    uint32_t i;
     nheld[p] = 0;
+    for (i = 0; i < 128u; i++) note_quiet[p][i] = 0;
     arp_stop_note(p);
     arp[p].was_on = 0;
     voices_release_part(p);
 }
