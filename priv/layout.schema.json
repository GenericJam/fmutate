{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fmutate/layout.schema.json",
  "title": "FMutate layout",
  "description": "One layout for one firmware. Positions are in cells of the authoring grid (grid.cols × grid.rows); renderers scale to the device grid.",
  "type": "object",
  "required": ["format", "id", "name", "firmware", "frame", "grid", "pages"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "fmutate.layout/1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
    "name": { "type": "string", "maxLength": 40 },
    "firmware": {
      "type": "object",
      "description": "Which firmware this layout is for. 'any' layouts only use universal bindings.",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "description": "Catalogue id, or 'any'." },
        "min_version": { "type": "string" }
      }
    },
    "frame": { "enum": ["landscape", "portrait"] },
    "grid": {
      "type": "object",
      "description": "The grid this layout was authored on.",
      "required": ["cols", "rows"],
      "properties": {
        "cols": { "type": "integer", "minimum": 1, "maximum": 40 },
        "rows": { "type": "integer", "minimum": 1, "maximum": 40 }
      }
    },
    "switcher": { "enum": ["names", "dots", "hidden"], "default": "names" },
    "dock": {
      "type": "array",
      "description": "Controls drawn at the same cells on every page. Page controls must not overlap them.",
      "items": { "$ref": "#/$defs/control" }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "controls"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$" },
          "name": { "type": "string", "maxLength": 12 },
          "controls": { "type": "array", "items": { "$ref": "#/$defs/control" } }
        }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "author": { "type": "string" },
        "made_by": { "enum": ["user", "preset", "app"], "description": "'app' = written by a sibling app over distribution." },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "$defs": {
    "cell": {
      "type": "object",
      "required": ["col", "row", "w", "h"],
      "properties": {
        "col": { "type": "integer", "minimum": 0 },
        "row": { "type": "integer", "minimum": 0 },
        "w": { "type": "integer", "minimum": 1 },
        "h": { "type": "integer", "minimum": 1 }
      }
    },
    "firmware_input": {
      "oneOf": [
        { "type": "object", "required": ["key"], "properties": { "key": { "type": "integer", "minimum": 0, "maximum": 26 } }, "additionalProperties": false },
        { "type": "object", "required": ["encoder"], "properties": {
            "encoder": { "enum": ["select", "presets", "algorithm", "knob1", "knob2", "knob3", "knob4"] },
            "pt_per_click": { "type": "number", "default": 6 },
            "invert": { "type": "boolean", "default": false } }, "additionalProperties": false },
        { "type": "object", "required": ["pot"], "properties": { "pot": { "const": "master" } }, "additionalProperties": false },
        { "type": "object", "required": ["button"], "properties": { "button": { "enum": ["oct_down", "oct_up", "fx", "sel", "env", "lfo", "edit", "glo", "home", "save", "arp", "seq", "play", "rec"] } }, "additionalProperties": false },
        { "type": "object", "required": ["midi"], "properties": { "midi": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "enum": ["note", "cc", "pitch_bend"] },
              "channel": { "type": "integer", "minimum": 1, "maximum": 16, "default": 1 },
              "number": { "type": "integer", "minimum": 0, "maximum": 127 },
              "jump": { "type": "boolean", "default": false, "description": "CC only: slider jumps to touch position." },
              "on": { "type": "integer", "minimum": 0, "maximum": 127, "default": 127, "description": "CC on a button: the value sent while pressed or toggled on." },
              "off": { "type": "integer", "minimum": 0, "maximum": 127, "default": 0, "description": "CC on a button: the value sent on release or toggle off, unless a control of this layout last set this CC (then that value comes back)." } } } }, "additionalProperties": false },
        { "type": "object", "required": ["page"], "properties": { "page": { "type": "string", "description": "'next', 'prev', or a page id." } }, "additionalProperties": false },
        { "type": "object", "required": ["action"], "properties": { "action": { "enum": ["bend"], "description": "bend: while on, keyboard strips bend instead of glissando (as glide = wobble)." } }, "additionalProperties": false }
      ]
    },
    "binding": {
      "type": "object",
      "description": "What a control (or one axis/gesture of it) drives.",
      "required": ["to"],
      "properties": {
        "on": { "enum": ["press", "long_press", "x", "y", "value"], "default": "press" },
        "to": { "$ref": "#/$defs/firmware_input" },
        "mode": { "enum": ["momentary", "toggle"], "default": "momentary" }
      }
    },
    "control": {
      "type": "object",
      "required": ["id", "type", "at"],
      "properties": {
        "id": { "type": "string" },
        "type": { "enum": ["menu", "key", "keyboard", "pad_grid", "button", "knob", "slider", "xy_pad", "strum", "screen", "label", "page_switcher"], "description": "'menu' is the creature button. Every layout has exactly one, in the dock; if missing, the renderer adds it at the first free cell from the top-left." },
        "at": { "$ref": "#/$defs/cell" },
        "label": { "type": "string", "maxLength": 16 },
        "color": { "enum": ["default", "coral", "amber", "sky", "violet"] },
        "bindings": { "type": "array", "items": { "$ref": "#/$defs/binding" } },

        "keyboard": {
          "type": "object",
          "description": "type = keyboard. Range is in firmware keys (0..26) plus octave arrows.",
          "properties": {
            "from_key": { "type": "integer", "minimum": 0, "maximum": 26 },
            "to_key": { "type": "integer", "minimum": 0, "maximum": 26 },
            "octave_arrows": { "type": "boolean", "default": true },
            "orientation": { "enum": ["horizontal", "vertical"], "default": "horizontal" },
            "glide": { "enum": ["glissando", "wobble"], "default": "glissando" },
            "bend_range": { "enum": [0.5, 1, 2], "default": 0.5, "description": "Semitones at half a key width of sideways slide; assumes the firmware's own bend range is ±2 (OberVave and ShineOn factory programs)." },
            "pitch_colors": { "type": "boolean", "default": false },
            "velocity": {
              "type": "object",
              "description": "fixed: firmware key presses at the firmware's own velocity (as the hardware). position: MIDI notes, velocity from where the key is struck (front edge = max, back = min); octave is the strip's own.",
              "properties": {
                "source": { "enum": ["fixed", "position"], "default": "fixed" },
                "min": { "type": "integer", "minimum": 1, "maximum": 127, "default": 40 },
                "max": { "type": "integer", "minimum": 1, "maximum": 127, "default": 127 },
                "swell": { "type": "boolean", "default": false, "description": "position only, opt-in: sliding front/back on a held key sets MIDI CC7 (volume), the same front = max, back = min. CC7 is the firmware's whole volume, so every sounding note swells together (a note's own velocity is fixed once it starts)." },
                "pressure": { "type": "boolean", "default": false, "description": "position only, opt-in, for firmwares that take MIDI polyphonic aftertouch as a note's level (FMutate's OberVave): the held note's own level follows the finger, full at the key's front edge, silent at its back edge. Takes precedence over swell." }
              },
              "additionalProperties": false
            },
            "scale": { "type": "string", "default": "chromatic", "description": "e.g. 'chromatic', 'D dorian'. Non-chromatic hides out-of-scale keys." }
          }
        },
        "pad_grid": {
          "type": "object",
          "description": "type = pad_grid. Pads listed left→right, top→bottom; each has its own bindings.",
          "properties": {
            "cols": { "type": "integer", "minimum": 1, "maximum": 8 },
            "rows": { "type": "integer", "minimum": 1, "maximum": 8 },
            "pads": { "type": "array", "items": { "type": "object", "properties": {
              "label": { "type": "string", "maxLength": 8 },
              "color": { "enum": ["default", "coral", "amber", "sky", "violet"] },
              "bindings": { "type": "array", "items": { "$ref": "#/$defs/binding" } } } } }
          }
        },
        "slider": {
          "type": "object",
          "properties": { "orientation": { "enum": ["vertical", "horizontal"], "default": "vertical" } }
        },
        "xy_pad": {
          "type": "object",
          "properties": { "on_release": { "enum": ["stay", "spring_back"], "default": "stay" } }
        },
        "strum": {
          "type": "object",
          "description": "Strings map to firmware keys, low at the bottom.",
          "properties": { "keys": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 26 } } }
        },
        "screen": {
          "type": "object",
          "properties": { "scale": { "type": "integer", "enum": [1, 2, 3, 4], "description": "Pixel-exact: the largest whole multiple of 240 device pixels that fits, up to this. Absent: fill (the largest square that fits the cells, sharp-scaled)." } }
        },
        "page_switcher": {
          "type": "object",
          "properties": { "look": { "enum": ["names", "dots"], "default": "names" } }
        }
      }
    }
  }
}
