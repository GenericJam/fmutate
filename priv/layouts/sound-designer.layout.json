{
  "format": "fmutate.layout/1",
  "id": "sound-designer",
  "name": "Sound designer",
  "firmware": { "id": "felucca" },
  "frame": "landscape",
  "grid": { "cols": 14, "rows": 6 },
  "switcher": "hidden",
  "dock": [
    { "id": "menu", "type": "menu", "at": { "col": 13, "row": 0, "w": 1, "h": 1 } }
  ],
  "pages": [
    {
      "id": "design",
      "name": "Design",
      "controls": [
        { "id": "screen", "type": "screen", "at": { "col": 0, "row": 0, "w": 5, "h": 4 } },
        { "id": "k1", "type": "slider", "label": "KNOB1", "at": { "col": 5, "row": 0, "w": 2, "h": 4 }, "bindings": [{ "on": "value", "to": { "encoder": "knob1" } }] },
        { "id": "k2", "type": "slider", "label": "KNOB2", "at": { "col": 7, "row": 0, "w": 2, "h": 4 }, "bindings": [{ "on": "value", "to": { "encoder": "knob2" } }] },
        { "id": "k3", "type": "slider", "label": "KNOB3", "at": { "col": 9, "row": 0, "w": 2, "h": 4 }, "bindings": [{ "on": "value", "to": { "encoder": "knob3" } }] },
        { "id": "k4", "type": "slider", "label": "KNOB4", "at": { "col": 11, "row": 0, "w": 2, "h": 4 }, "bindings": [{ "on": "value", "to": { "encoder": "knob4" } }] },
        { "id": "oct_up", "type": "button", "label": "OCT+", "at": { "col": 13, "row": 1, "w": 1, "h": 1 }, "bindings": [{ "to": { "button": "oct_up" } }] },
        { "id": "oct_down", "type": "button", "label": "OCT−", "at": { "col": 13, "row": 2, "w": 1, "h": 1 }, "bindings": [{ "to": { "button": "oct_down" } }] },
        { "id": "save", "type": "button", "label": "SAVE", "at": { "col": 13, "row": 3, "w": 1, "h": 1 }, "bindings": [{ "to": { "button": "save" } }] },
        { "id": "keys", "type": "keyboard", "at": { "col": 0, "row": 4, "w": 14, "h": 2 },
          "keyboard": { "from_key": 7, "to_key": 19, "octave_arrows": true, "glide": "wobble", "bend_range": 2 } }
      ]
    }
  ],
  "meta": { "made_by": "preset", "note": "Slider labels should be Felucca's parameter names; ask the firmware author or read its docs." }
}
