{
  "format": "fmutate.layout/1",
  "id": "classic",
  "name": "Classic",
  "firmware": { "id": "any" },
  "frame": "landscape",
  "grid": { "cols": 14, "rows": 6 },
  "switcher": "hidden",
  "dock": [
    { "id": "menu", "type": "menu", "at": { "col": 0, "row": 0, "w": 1, "h": 1 } }
  ],
  "pages": [
    {
      "id": "panel",
      "name": "Panel",
      "controls": [
        { "id": "oct_down", "type": "button", "label": "OCT−", "at": { "col": 0, "row": 1, "w": 1, "h": 1 }, "bindings": [{ "to": { "button": "oct_down" } }] },
        { "id": "oct_up", "type": "button", "label": "OCT+", "at": { "col": 0, "row": 2, "w": 1, "h": 1 }, "bindings": [{ "to": { "button": "oct_up" } }] },

        { "id": "master", "type": "knob", "label": "MASTER", "at": { "col": 1, "row": 0, "w": 1, "h": 1 }, "bindings": [{ "on": "value", "to": { "pot": "master" } }] },
        { "id": "select", "type": "knob", "label": "SELECT", "at": { "col": 2, "row": 0, "w": 1, "h": 1 }, "bindings": [{ "on": "value", "to": { "encoder": "select" } }] },
        { "id": "presets", "type": "knob", "label": "PRESETS", "at": { "col": 1, "row": 1, "w": 1, "h": 1 }, "bindings": [{ "on": "value", "to": { "encoder": "presets" } }] },
        { "id": "algorithm", "type": "knob", "label": "ALGO", "at": { "col": 2, "row": 1, "w": 1, "h": 1 }, "bindings": [{ "on": "value", "to": { "encoder": "algorithm" } }] },

        { "id": "screen", "type": "screen", "at": { "col": 3, "row": 0, "w": 4, "h": 3 } },

        { "id": "knob1", "type": "knob", "label": "KNOB1", "at": { "col": 7, "row": 0, "w": 1, "h": 1 }, "bindings": [{ "on": "value", "to": { "encoder": "knob1" } }] },
        { "id": "knob2", "type": "knob", "label": "KNOB2", "at": { "col": 8, "row": 0, "w": 1, "h": 1 }, "bindings": [{ "on": "value", "to": { "encoder": "knob2" } }] },
        { "id": "knob3", "type": "knob", "label": "KNOB3", "at": { "col": 9, "row": 0, "w": 1, "h": 1 }, "bindings": [{ "on": "value", "to": { "encoder": "knob3" } }] },
        { "id": "knob4", "type": "knob", "label": "KNOB4", "at": { "col": 10, "row": 0, "w": 1, "h": 1 }, "bindings": [{ "on": "value", "to": { "encoder": "knob4" } }] },

        { "id": "fx", "type": "button", "label": "FX", "at": { "col": 8, "row": 1, "w": 1, "h": 1 }, "bindings": [{ "to": { "button": "fx" } }] },
        { "id": "sel", "type": "button", "label": "SEL", "at": { "col": 9, "row": 1, "w": 1, "h": 1 }, "bindings": [{ "to": { "button": "sel" } }] },
        { "id": "env", "type": "button", "label": "ENV", "at": { "col": 10, "row": 1, "w": 1, "h": 1 }, "bindings": [{ "to": { "button": "env" } }] },
        { "id": "lfo", "type": "button", "label": "LFO", "at": { "col": 11, "row": 1, "w": 1, "h": 1 }, "bindings": [{ "to": { "button": "lfo" } }] },
        { "id": "edit", "type": "button", "label": "EDIT", "at": { "col": 12, "row": 1, "w": 1, "h": 1 }, "bindings": [{ "to": { "button": "edit" } }] },
        { "id": "glo", "type": "button", "label": "GLO", "at": { "col": 13, "row": 1, "w": 1, "h": 1 }, "bindings": [{ "to": { "button": "glo" } }] },
        { "id": "home", "type": "button", "label": "HOME", "at": { "col": 8, "row": 2, "w": 1, "h": 1 }, "bindings": [{ "to": { "button": "home" } }] },
        { "id": "save", "type": "button", "label": "SAVE", "at": { "col": 9, "row": 2, "w": 1, "h": 1 }, "bindings": [{ "to": { "button": "save" } }] },
        { "id": "arp", "type": "button", "label": "ARP", "at": { "col": 10, "row": 2, "w": 1, "h": 1 }, "bindings": [{ "to": { "button": "arp" } }] },
        { "id": "seq", "type": "button", "label": "SEQ", "at": { "col": 11, "row": 2, "w": 1, "h": 1 }, "bindings": [{ "to": { "button": "seq" } }] },
        { "id": "play", "type": "button", "label": "PLAY", "at": { "col": 12, "row": 2, "w": 1, "h": 1 }, "bindings": [{ "to": { "button": "play" } }] },
        { "id": "rec", "type": "button", "label": "REC", "at": { "col": 13, "row": 2, "w": 1, "h": 1 }, "bindings": [{ "to": { "button": "rec" } }] },

        { "id": "keys", "type": "keyboard", "at": { "col": 0, "row": 3, "w": 14, "h": 3 },
          "keyboard": { "from_key": 0, "to_key": 26, "octave_arrows": false, "glide": "glissando" } }
      ]
    }
  ],
  "meta": { "made_by": "preset" }
}
